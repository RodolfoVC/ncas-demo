---
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../lib/cms';

let posts = [];
let cmsError: string | null = null;
try {
  posts = await getPosts();
} catch (e) {
  cmsError = e instanceof Error ? e.message : 'No se pudo conectar con el CMS';
}
---
<Base title="Blog" description="Artículos de NCAS sobre tecnología, modernización de software y arquitectura.">
  <section class="max-w-5xl mx-auto px-6 py-16">
    <h1 class="text-3xl font-bold mb-2">Blog</h1>
    <p class="text-sm text-slate-500 mb-8">Contenido editable desde el panel de Strapi — módulo "Posts".</p>
    {cmsError ? (
      <p class="text-red-600 text-sm">No se pudo cargar desde el CMS: {cmsError}</p>
    ) : posts.length === 0 ? (
      <p class="text-slate-500 text-sm">Aún no hay artículos publicados.</p>
    ) : (
      <div class="space-y-6">
        {posts.map((p: any) => (
          <article class="border border-slate-200 rounded-lg p-6">
            <time class="text-xs text-slate-400">{new Date(p.fecha).toLocaleDateString('es-CL', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
            <h2 class="text-xl font-semibold text-brand-dark mt-1 mb-2">
              <a href={`/blog/${p.slug}`} class="hover:underline">{p.titulo}</a>
            </h2>
            <p class="text-slate-600 text-sm mb-3">{p.resumen}</p>
            <a href={`/blog/${p.slug}`} class="text-brand text-sm font-medium hover:underline">Leer más →</a>
          </article>
        ))}
      </div>
    )}
  </section>
</Base>
