---
import Base from '../layouts/Base.astro';
import { getProyectos } from '../lib/cms';

let proyectos = [];
let cmsError: string | null = null;
try {
  proyectos = await getProyectos();
} catch (e) {
  cmsError = e instanceof Error ? e.message : 'No se pudo conectar con el CMS';
}
---
<Base title="Proyectos">
  <section class="dots px-6 pt-20 pb-14">
    <div class="max-w-6xl mx-auto">
      <span class="font-mono text-xs font-semibold text-accent2 tracking-wide">PROYECTOS</span>
      <h1 class="text-4xl font-extrabold mt-3">Nuestros focos más importantes</h1>
      <p class="text-muted max-w-2xl mt-3">Este listado completo viene del módulo "Proyectos" en Strapi.</p>
    </div>
  </section>
  <section class="px-6 pb-20">
    <div class="max-w-6xl mx-auto">
      {cmsError ? (
        <p class="text-red-400 text-sm">No se pudo cargar desde el CMS: {cmsError}</p>
      ) : proyectos.length === 0 ? (
        <p class="text-muted text-sm">Aún no hay proyectos cargados.</p>
      ) : (
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {proyectos.map((p: any) => (
            <div class="bg-card border border-white/10 border-t-2 rounded-xl p-6" style="border-top-color:#2ABEEF;">
              <span class="font-mono text-xs uppercase tracking-wide text-accent2 font-semibold">{p.industria}</span>
              <h3 class="font-bold mt-2 mb-2">{p.nombre}</h3>
              <p class="text-sm text-muted">{p.descripcion}</p>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>
</Base>