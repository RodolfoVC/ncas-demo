---
import Base from '../layouts/Base.astro';
import { getProyectos } from '../lib/cms';

let proyectos = [];
let cmsError: string | null = null;
try {
  proyectos = await getProyectos();
} catch (e) {
  cmsError = e instanceof Error ? e.message : 'No se pudo conectar con el CMS';
}
---
<Base title="Proyectos" description="Proyectos destacados desarrollados por NCAS: seguridad, logística, minería y más.">
  <section class="max-w-5xl mx-auto px-6 py-16">
    <h1 class="text-3xl font-bold mb-2">Proyectos</h1>
    <p class="text-sm text-slate-500 mb-8">Este listado completo viene del módulo "Proyectos" en Strapi.</p>
    {cmsError ? (
      <p class="text-red-600 text-sm">No se pudo cargar desde el CMS: {cmsError}</p>
    ) : proyectos.length === 0 ? (
      <p class="text-slate-500 text-sm">Aún no hay proyectos cargados.</p>
    ) : (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {proyectos.map((p: any) => (
          <div class="border border-slate-200 rounded-lg p-5">
            <span class="text-xs uppercase tracking-wide text-brand font-semibold">{p.industria}</span>
            <h3 class="font-semibold text-brand-dark mt-1 mb-2">{p.nombre}</h3>
            <p class="text-sm text-slate-600">{p.descripcion}</p>
          </div>
        ))}
      </div>
    )}
  </section>
</Base>
