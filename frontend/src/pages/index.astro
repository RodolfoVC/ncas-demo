---
import Base from '../layouts/Base.astro';
import { getTestimonios, getProyectos } from '../lib/cms';

let testimonios = [];
let proyectos = [];
let cmsError: string | null = null;

try {
  [testimonios, proyectos] = await Promise.all([getTestimonios(), getProyectos()]);
} catch (e) {
  cmsError = e instanceof Error ? e.message : 'No se pudo conectar con el CMS';
}

const servicios = [
  { nombre: 'Software a medida', desc: 'Aplicaciones móviles, desktop, web y para smart TV.' },
  { nombre: 'Hardware a medida', desc: 'Desarrollo industrial y de prototipos.' },
  { nombre: 'Soporte', desc: 'Mantenimiento evolutivo y correctivo.' },
  { nombre: 'Integración', desc: 'Conectividad entre APIs, software y hardware.' },
  { nombre: 'Consultoría', desc: 'Arquitectura, infraestructura y gestión de equipos.' }
];
---
<Base title="Inicio" description="NCAS: ecosistemas tecnológicos escalables, mantenibles y robustos. Software y hardware a medida, soporte, integración y consultoría.">
  <section class="bg-brand-light">
    <div class="max-w-5xl mx-auto px-6 py-20 text-center">
      <h1 class="text-4xl font-bold text-brand-dark mb-4">Ecosistemas tecnológicos escalables, mantenibles y robustos</h1>
      <p class="text-slate-600 max-w-2xl mx-auto">Sitio de prueba construido con Astro + Tailwind CSS en el frontend y Strapi como CMS headless para los módulos autoadministrables (testimonios, proyectos y blog).</p>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6 py-16">
    <h2 class="text-2xl font-bold mb-8">Servicios</h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {servicios.map((s) => (
       <div class="group border border-slate-200 rounded-lg p-5 shadow-sm transition-all duration-200 hover:shadow-lg hover:-translate-y-1 hover:border-brand dark:bg-slate-800 dark:border-slate-700">
  <h3 class="font-semibold text-brand-dark mb-2 dark:text-brand-light">{s.nombre}</h3>
  <p class="text-sm text-slate-600 dark:text-slate-300">{s.desc}</p>
</div>
      ))}
    </div>
  </section>

  <section class="bg-slate-50">
    <div class="max-w-5xl mx-auto px-6 py-16">
      <h2 class="text-2xl font-bold mb-2">Testimonios</h2>
      <p class="text-sm text-slate-500 mb-8">Contenido editable desde el panel de Strapi — módulo "Testimonios".</p>
      {cmsError ? (
        <p class="text-red-600 text-sm">No se pudo cargar desde el CMS: {cmsError}</p>
      ) : testimonios.length === 0 ? (
        <p class="text-slate-500 text-sm">Aún no hay testimonios cargados en el CMS.</p>
      ) : (
        <div class="grid sm:grid-cols-2 gap-6">
          {testimonios.map((t: any) => (
            <blockquote class="bg-white border border-slate-200 rounded-lg p-6">
              <p class="italic text-slate-700 mb-4">&ldquo;{t.cita}&rdquo;</p>
              <footer class="text-sm font-medium text-brand-dark">{t.nombre} — {t.empresa}</footer>
            </blockquote>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6 py-16">
    <h2 class="text-2xl font-bold mb-2">Proyectos destacados</h2>
    <p class="text-sm text-slate-500 mb-8">Contenido editable desde el panel de Strapi — módulo "Proyectos".</p>
    {cmsError ? (
      <p class="text-red-600 text-sm">No se pudo cargar desde el CMS.</p>
    ) : proyectos.length === 0 ? (
      <p class="text-slate-500 text-sm">Aún no hay proyectos cargados en el CMS.</p>
    ) : (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {proyectos.map((p: any) => (
          <div class="border border-slate-200 rounded-lg p-5">
            <span class="text-xs uppercase tracking-wide text-brand font-semibold">{p.industria}</span>
            <h3 class="font-semibold text-brand-dark mt-1 mb-2">{p.nombre}</h3>
            <p class="text-sm text-slate-600">{p.descripcion}</p>
          </div>
        ))}
      </div>
    )}
  </section>
</Base>
