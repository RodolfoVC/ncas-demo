---
import Base from '../layouts/Base.astro';
import MapaSudamerica from '../components/MapaSudamerica.astro';
import { getServicios, getTestimonios, getProyectos } from '../lib/cms';
import type { Servicio } from '../lib/cms';

let servicios: Servicio[] = [];
let testimonios = [];
let proyectos = [];
let cmsError: string | null = null;

try {
  [servicios, testimonios, proyectos] = await Promise.all([getServicios(), getTestimonios(), getProyectos()]);
} catch (e) {
  cmsError = e instanceof Error ? e.message : 'No se pudo conectar con el CMS';
}

// Cada tarjeta de "Servicios" trae un ícono predefinido desde Strapi (campo "icono");
// el SVG en sí se mantiene acá en el código para no aceptar HTML libre desde el CMS.
const ICONOS: Record<string, string> = {
  software: '<path d="M8 9l-4 3 4 3M16 9l4 3-4 3M13.5 6l-3 12"></path>',
  hardware: '<rect x="7" y="7" width="10" height="10" rx="1.6"></rect><path d="M9 3v4M15 3v4M9 17v4M15 17v4M3 9h4M3 15h4M17 9h4M17 15h4"></path>',
  soporte: '<path d="M4 13v-1a8 8 0 0 1 16 0v1"></path><rect x="2.3" y="13" width="4" height="6.5" rx="1.6"></rect><rect x="17.7" y="13" width="4" height="6.5" rx="1.6"></rect>',
  integraciones: '<circle cx="6" cy="6" r="2.4"></circle><circle cx="18" cy="6" r="2.4"></circle><circle cx="12" cy="18" r="2.4"></circle><path d="M8.1 7.3L11 16M15.9 7.3L13 16M8.4 6h7.2"></path>',
};
---
<Base title="Inicio" description="NCAS: ecosistemas tecnológicos escalables, mantenibles y robustos. Software y hardware a medida, soporte, integración y consultoría.">
  <!-- HERO -->
  <section class="dots relative overflow-hidden px-6 pt-24 pb-20 md:pt-32 md:pb-24">
    <div class="hero-glow absolute -top-40 -right-28 w-[420px] h-[420px] md:w-[640px] md:h-[640px] rounded-full pointer-events-none"
         style="background: radial-gradient(circle, #EF5D2C33 0%, transparent 70%); filter: blur(10px);"></div>
    <div class="relative max-w-6xl mx-auto">
      <div class="reveal reveal-1 inline-flex items-center gap-2 bg-white/5 border border-white/10 rounded-full pl-3 pr-4 py-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-ok"></span>
        <span class="font-mono text-xs text-white/70">Operando en 6 países de Latinoamérica</span>
      </div>
      <h1 class="reveal reveal-2 text-4xl md:text-6xl font-black leading-tight tracking-tight mt-7 max-w-2xl">
        Software y<br>Hardware a tu<br>medida.
      </h1>
      <p class="reveal reveal-3 text-lg text-muted max-w-xl mt-6 leading-relaxed">
        Desarrollamos en todas las plataformas y manejamos un gran número de integraciones.
        Somos tu aliado perfecto para el desarrollo de soluciones en tecnología.
      </p>
      <div class="reveal reveal-4 flex flex-wrap gap-4 mt-9">
        <a href="/contacto" class="bg-accent text-night font-extrabold text-sm px-7 py-3.5 rounded-lg">Contáctanos →</a>
        <a href="/proyectos" class="border border-white/20 font-bold text-sm px-7 py-3.5 rounded-lg">Ver proyectos</a>
      </div>
    </div>
  </section>

  <!-- SERVICIOS -->
  <section class="px-6 py-20 md:py-24">
    <div class="max-w-6xl mx-auto">
      <span class="font-mono text-xs font-semibold text-accent tracking-wide">SERVICIOS</span>
      <h2 class="text-3xl md:text-4xl font-extrabold mt-3">Cómo podemos apoyarte</h2>
      <p class="text-muted max-w-xl mt-3">Soluciones integrales para lograr ecosistemas de tecnología escalables, mantenibles, robustos y con alta disponibilidad.</p>

      {servicios.length > 0 ? (
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5 mt-10">
          {servicios.map((s) => (
            <div class="dots bg-card border border-white/10 rounded-2xl p-7">
              <div class="w-11 h-11 rounded-lg bg-white/5 flex items-center justify-center text-accent">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={ICONOS[s.icono] ?? ICONOS.software}></svg>
              </div>
              <h3 class="font-bold mt-4">{s.nombre}</h3>
              <p class="text-sm text-muted mt-2 leading-relaxed">{s.descripcion}</p>
            </div>
          ))}
        </div>
      ) : (
        <p class="text-muted text-sm mt-10">Aún no hay servicios cargados en el CMS.</p>
      )}
    </div>
  </section>

  <!-- TESTIMONIOS (dinámico desde Strapi) -->
  <section class="bg-panel border-y border-white/10">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <span class="font-mono text-xs font-semibold text-accent2 tracking-wide">TESTIMONIOS</span>
      <h2 class="text-3xl font-extrabold mt-3">Lo que dicen nuestros clientes</h2>
      {cmsError ? (
        <p class="text-red-400 text-sm mt-6">No se pudo cargar desde el CMS: {cmsError}</p>
      ) : testimonios.length === 0 ? (
        <p class="text-muted text-sm mt-6">Aún no hay testimonios cargados en el CMS.</p>
      ) : (
        <div class="grid sm:grid-cols-2 gap-6 mt-10">
          {testimonios.map((t: any) => (
            <blockquote class="bg-card border border-white/10 rounded-2xl p-7">
              <p class="italic text-ink/90 mb-4">&ldquo;{t.cita}&rdquo;</p>
              <footer class="text-sm font-bold text-muted">{t.nombre} — {t.empresa}</footer>
            </blockquote>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- PROYECTOS DESTACADOS (dinámico desde Strapi) -->
  <section class="px-6 py-20">
    <div class="max-w-6xl mx-auto">
      <span class="font-mono text-xs font-semibold text-accent2 tracking-wide">PROYECTOS</span>
      <h2 class="text-3xl font-extrabold mt-3">Presentes en las industrias más exigentes</h2>
      {cmsError ? (
        <p class="text-red-400 text-sm mt-6">No se pudo cargar desde el CMS.</p>
      ) : proyectos.length === 0 ? (
        <p class="text-muted text-sm mt-6">Aún no hay proyectos cargados en el CMS.</p>
      ) : (
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5 mt-10">
          {proyectos.map((p: any) => (
            <div class="bg-card border border-white/10 border-t-2 rounded-xl p-6" style="border-top-color:#2ABEEF;">
              <span class="font-mono text-xs uppercase tracking-wide text-accent2 font-semibold">{p.industria}</span>
              <h3 class="font-bold mt-2 mb-2">{p.nombre}</h3>
              <p class="text-sm text-muted">{p.descripcion}</p>
            </div>
          ))}
        </div>
      )}
      <a href="/proyectos" class="inline-flex items-center gap-2 text-accent2 font-bold text-sm mt-8">Ver todos los proyectos →</a>
    </div>
  </section>

    <!-- CONSULTORÍA -->
  <section class="px-6 py-20 md:py-24 bg-panel border-y border-white/10">
    <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-12 md:gap-16 items-start">
      <div>
        <span class="font-mono text-xs font-semibold text-accent tracking-wide">CONSULTORÍA</span>
        <h2 class="text-3xl font-extrabold mt-3 leading-tight">Podemos asesorarte en tu digitalización</h2>
        <p class="text-muted mt-4 leading-relaxed">Nuestras consultorías integrales en ingeniería y tecnologías de la información abordan desde infraestructura y arquitectura hasta gestión de equipos de alto rendimiento.</p>
      </div>
      <div class="dots bg-card border border-white/10 rounded-2xl p-8 flex flex-col gap-6">
        <div class="flex gap-3.5 items-start">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="text-accent shrink-0 mt-0.5"><circle cx="12" cy="12" r="9"></circle><path d="M8 12.5l2.5 2.5L16 9.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          <span class="text-sm text-ink/90 leading-relaxed">Migración de sistemas monolíticos a microservicios.</span>
        </div>
        <div class="flex gap-3.5 items-start">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="text-accent shrink-0 mt-0.5"><circle cx="12" cy="12" r="9"></circle><path d="M8 12.5l2.5 2.5L16 9.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          <span class="text-sm text-ink/90 leading-relaxed">Captura de requerimientos, puntos de control, excepciones y casos borde.</span>
        </div>
        <div class="flex gap-3.5 items-start">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="text-accent shrink-0 mt-0.5"><circle cx="12" cy="12" r="9"></circle><path d="M8 12.5l2.5 2.5L16 9.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          <span class="text-sm text-ink/90 leading-relaxed">Implementación de infraestructura local o como servicio.</span>
        </div>
        <div class="flex gap-3.5 items-start">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="text-accent shrink-0 mt-0.5"><circle cx="12" cy="12" r="9"></circle><path d="M8 12.5l2.5 2.5L16 9.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          <span class="text-sm text-ink/90 leading-relaxed">Digitalización y automatización de procesos por IoT o APIs centralizadas.</span>
        </div>
        <div class="flex gap-3.5 items-start">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="text-accent shrink-0 mt-0.5"><circle cx="12" cy="12" r="9"></circle><path d="M8 12.5l2.5 2.5L16 9.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          <span class="text-sm text-ink/90 leading-relaxed">Capacitación y consultoría en TI e ingeniería.</span>
        </div>
      </div>
    </div>
  </section>
    <!-- PRESENCIA -->
  <section class="px-6 py-20 border-y border-white/10">
    <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-12 items-center">
      <div>
        <span class="font-mono text-xs font-semibold text-accent2 tracking-wide">PRESENCIA</span>
        <h2 class="text-3xl font-extrabold mt-3">Presencia en Sudamérica</h2>
        <p class="text-muted mt-4 leading-relaxed">Operamos con equipos y proyectos activos en 6 países de la región.</p>
        <div class="flex flex-wrap gap-2.5 mt-6">
          <span class="font-mono text-xs bg-white/5 border border-white/10 rounded-full px-3.5 py-1.5 text-ink/90">Chile</span>
          <span class="font-mono text-xs bg-white/5 border border-white/10 rounded-full px-3.5 py-1.5 text-ink/90">Argentina</span>
          <span class="font-mono text-xs bg-white/5 border border-white/10 rounded-full px-3.5 py-1.5 text-ink/90">Brasil</span>
          <span class="font-mono text-xs bg-white/5 border border-white/10 rounded-full px-3.5 py-1.5 text-ink/90">Colombia</span>
          <span class="font-mono text-xs bg-white/5 border border-white/10 rounded-full px-3.5 py-1.5 text-ink/90">Perú</span>
          <span class="font-mono text-xs bg-white/5 border border-white/10 rounded-full px-3.5 py-1.5 text-ink/90">Bolivia</span>
        </div>
      </div>
      <MapaSudamerica />
    </div>
  </section>
    <!-- CTA CONTACTO -->
  <section class="relative overflow-hidden px-6 py-24 md:py-28 text-center">
    <div class="absolute -top-48 left-1/2 -translate-x-1/2 w-[500px] h-[320px] md:w-[800px] md:h-[500px] rounded-full pointer-events-none" style="background: radial-gradient(circle, #EF5D2C2e 0%, transparent 72%);"></div>
    <div class="relative z-10">
      <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight">¿Tienes un proyecto en mente?</h2>
      <p class="text-muted mt-4 max-w-md mx-auto">Cuéntanos qué necesitas construir.</p>
      <a href="/contacto" class="inline-block mt-8 bg-accent text-night font-extrabold text-sm px-8 py-4 rounded-lg">Contáctanos</a>
    </div>
  </section>
</Base>

