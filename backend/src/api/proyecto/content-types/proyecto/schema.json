{
  "kind": "collectionType",
  "collectionName": "proyectos",
  "info": {
    "singularName": "proyecto",
    "pluralName": "proyectos",
    "displayName": "Proyecto",
    "description": "Casos de proyectos por industria, editables por el equipo de marketing sin ayuda de desarrollo."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "nombre": {
      "type": "string",
      "required": true
    },
    "industria": {
      "type": "string",
      "required": true
    },
    "descripcion": {
      "type": "text",
      "required": true,
      "maxLength": 500
    },
    "imagen": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    }
  }
}
