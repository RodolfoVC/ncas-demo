{
  "kind": "collectionType",
  "collectionName": "servicios",
  "info": {
    "singularName": "servicio",
    "pluralName": "servicios",
    "displayName": "Servicio",
    "description": "Tarjetas de la sección \"Cómo podemos apoyarte\" del home, editables sin ayuda de desarrollo."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "nombre": {
      "type": "string",
      "required": true
    },
    "descripcion": {
      "type": "text",
      "required": true,
      "maxLength": 300
    },
    "icono": {
      "type": "enumeration",
      "enum": ["software", "hardware", "soporte", "integraciones"],
      "required": true,
      "default": "software"
    },
    "orden": {
      "type": "integer",
      "default": 0
    }
  }
}
