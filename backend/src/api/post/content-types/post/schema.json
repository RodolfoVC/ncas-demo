{
  "kind": "collectionType",
  "collectionName": "posts",
  "info": {
    "singularName": "post",
    "pluralName": "posts",
    "displayName": "Post de blog",
    "description": "Artículos del blog, editables por el equipo de marketing sin ayuda de desarrollo."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titulo": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "titulo",
      "required": true
    },
    "resumen": {
      "type": "text",
      "required": true,
      "maxLength": 280
    },
    "contenido": {
      "type": "richtext",
      "required": true
    },
    "fecha": {
      "type": "date",
      "required": true
    },
    "imagen": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    }
  }
}
